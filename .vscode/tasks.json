{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Configure CMake",
			"type": "process",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"${workspaceFolder}\\.vscode\\msvc.cmd",
				"cmake",
				"-S",
				"${workspaceFolder}",
				"-B",
				"${workspaceFolder}\\build"
			],
			"options": {
				// Used only when the build directory is configured for the first
				// time; an existing one keeps the generator it was created with.
				"env": {
					"CMAKE_GENERATOR": "Ninja Multi-Config"
				}
			},
			"problemMatcher": []
		},
		{
			"label": "Build ReSTIR GI",
			"type": "process",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"${workspaceFolder}\\.vscode\\msvc.cmd",
				"cmake",
				"--build",
				"${workspaceFolder}\\build",
				"--config",
				"Debug",
				"--target",
				"restir_gi"
			],
			"dependsOn": "Configure CMake",
			"dependsOrder": "sequence",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "Build ReSTIR GI (Release)",
			"type": "process",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"${workspaceFolder}\\.vscode\\msvc.cmd",
				"cmake",
				"--build",
				"${workspaceFolder}\\build",
				"--config",
				"Release",
				"--target",
				"restir_gi"
			],
			"dependsOn": "Configure CMake",
			"dependsOrder": "sequence",
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			]
		}
	]
}
