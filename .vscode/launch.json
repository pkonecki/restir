		{
			"name": "Release ReSTIR GI",
			"type": "cppvsdbg",
			"request": "launch",
			"program": "${workspaceFolder}\\build\\Release\\restir_gi.exe",
			"args": ["--d3d12"],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}\\build\\Release",
			"environment": [],
			"console": "integratedTerminal",
			"preLaunchTask": "Build ReSTIR GI (Release)"
		}
	]
